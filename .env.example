# Copy this file to `.env` and fill in the keys you have.
# At least one of the two providers is required. DataCern auto-switches
# between them when one runs out of credits or fails.

# Google Gemini (free tier at https://aistudio.google.com -> "Get API key")
GEMINI_API_KEY=your_gemini_api_key

# OpenAI (pay-as-you-go at https://platform.openai.com -> API keys)
OPENAI_API_KEY=your_openai_api_key

# Provider priority: "gemini" (default) | "openai" | "auto"
LLM_PROVIDER_PREFERENCE=gemini

# Optional model overrides (defaults shown):
# LLM_MODEL=gpt-4o-mini
# GEMINI_LLM_MODEL=gemini-flash-latest
# EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional runtime tuning (defaults shown):
# LLM_TEMPERATURE=0.2
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=8
# EXEC_TIMEOUT=30
# CHART_MAX_ATTEMPTS=3
# MAX_UPLOAD_MB=50
