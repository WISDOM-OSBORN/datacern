# Copy this file to `.env` and fill in the keys you have.
# At least one provider is required. DataCern auto-switches
# between them when one runs out of credits or fails.

# Google Gemini (free tier at https://aistudio.google.com -> "Get API key")
# Note: gemini-2.0-flash has separate quota from gemini-3.8-flash (20 req/day)
GEMINI_API_KEY=

# Groq (free tier at https://console.groq.com/keys — no card required)
# Live models: https://api.groq.com/openai/v1/models
# Valid IDs: openai/gpt-oss-20b, openai/gpt-oss-120b, llama-3.3-70b-versatile, qwen/qwen3-8b
GROQ_API_KEY=

# OpenRouter (free models at https://openrouter.ai/keys — no card for :free models)
# Current free IDs (2026-09): google/gemma-4-26b-a4b-it:free, z-ai/glm-5.2:free, nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Check https://openrouter.ai/models?filter=free for latest
OPENROUTER_API_KEY=

# OpenAI (pay-as-you-go at https://platform.openai.com -> API keys)
OPENAI_API_KEY=

# Provider priority: "gemini" (default) | "groq" | "openrouter" | "openai" | "auto"
LLM_PROVIDER_PREFERENCE=groq

# Optional model overrides (defaults shown):
# LLM_MODEL=gpt-4o-mini
# GEMINI_LLM_MODEL=gemini-2.0-flash
# GROQ_LLM_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENROUTER_LLM_MODEL=google/gemma-4-26b-a4b-it:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Free OpenRouter alternatives (verified 2026-09):
# google/gemma-4-26b-a4b-it:free
# google/gemma-4-31b-it:free
# z-ai/glm-5.2:free
# nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Optional runtime tuning (defaults shown):
# LLM_TEMPERATURE=0.2
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=8
# EXEC_TIMEOUT=30
# CHART_MAX_ATTEMPTS=3
# MAX_UPLOAD_MB=50
