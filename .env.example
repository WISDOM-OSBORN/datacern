# Copy this file to `.env` and fill in the keys you have.
# At least one provider is required. DataCern auto-switches
# between them when one runs out of credits or fails.

# Google Gemini (free tier at https://aistudio.google.com -> "Get API key")
GEMINI_API_KEY=

# Groq (free tier at https://console.groq.com/keys — no card required)
GROQ_API_KEY=

# OpenRouter (free models at https://openrouter.ai/keys — no card for :free models)
OPENROUTER_API_KEY=

# OpenAI (pay-as-you-go at https://platform.openai.com -> API keys)
OPENAI_API_KEY=

# Provider priority: "gemini" (default) | "groq" | "openrouter" | "openai" | "auto"
LLM_PROVIDER_PREFERENCE=gemini

# Optional model overrides (defaults shown):
# LLM_MODEL=gpt-4o-mini
# GEMINI_LLM_MODEL=gemini-flash-latest
# GROQ_LLM_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENROUTER_LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Free OpenRouter alternatives (pick one for OPENROUTER_LLM_MODEL):
# mistralai/mistral-7b-instruct:free  (32K, lightweight)
# google/gemma-2-9b-it:free          (8K, good reasoning)
# qwen/qwen-2.5-7b-instruct:free     (32K, multilingual+code)
# deepseek/deepseek-r1-distill-qwen-7b:free

# Groq: live models at https://api.groq.com/openai/v1/models
# e.g. GROQ_LLM_MODEL=llama-3.3-70b-versatile or openai/gpt-oss-20b

# Optional runtime tuning (defaults shown):
# LLM_TEMPERATURE=0.2
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=8
# EXEC_TIMEOUT=30
# CHART_MAX_ATTEMPTS=3
# MAX_UPLOAD_MB=50
